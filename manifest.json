{
  "manifest_version": 3,
  "name": "Google Docs Background",
  "version": "1.0",
  "description": "Add custom background images to Google Docs.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}